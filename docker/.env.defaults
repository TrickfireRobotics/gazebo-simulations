# Committed defaults for docker exposed ports (and optional flags).
#
# This file is the source of truth. On `devcontainer up`, .devcontainer/detect-host-env.sh
# generates the real (gitignored) docker/.env from: these defaults + your optional
# docker/.env.local overrides + host-detected values (DISPLAY/GPU). To change ports or
# force VNC on YOUR machine, create docker/.env.local with the keys you want to override
# — do not edit this file (it's shared) or docker/.env (it's regenerated each up).

VNC_PORT=5900
NOVNC_PORT=6080
ROSBRIDGE_PORT=9090

# set to 1 in docker/.env.local if you want to force vnc startup
# FORCE_VNC=1
